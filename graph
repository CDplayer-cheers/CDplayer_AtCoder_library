template <typename T>
struct Edge
{
    ll to;
    T cost;
    Edge(ll _to, ll _cost = 1) : to(_to), cost(_cost) {}
};
template <typename cost_type>
struct Graph
{
    int num_of_vertex;
    vector<vector<Edge<cost_type>>> g;
    vector<vector<Edge<cost_type>>> gr;
    bool is_directed;
    Graph(int _num_of_vertex = 0, bool _is_directed = false) : num_of_vertex(_num_of_vertex), g(num_of_vertex), gr(num_of_vertex), is_directed(_is_directed) {}

    void add_edge(int a, int b, cost_type cost = 1)
    {
        g.at(a).push_back(Edge<cost_type>(b, cost));
        if (is_directed)
        {
            gr.at(b).push_back(Edge<cost_type>(a, cost));
        }
        else
        {
            g.at(b).push_back(Edge<cost_type>(a, cost));
        }
    }

    /**
     * using like this
     * auto ans = g.dfs<ll>(0, 0, [&](int index, ll val, ll cost)
     *                        { return val + cost; });
     */
    template <typename val_type>
    auto dfs(int first_index, val_type first_value, function<val_type(int, val_type, ll)> f, function<void(int, val_type)> not_visited = [](int index, val_type val) {}, function<void(int, val_type, val_type)> when_visited = [](int index, val_type cur_val, val_type prev_val) {})
    {
        vector<bool> visited(num_of_vertex);
        vector<val_type> ans(num_of_vertex);
        stack<pair<int, val_type>> task;
        task.push(make_pair(first_index, first_value));

        while (!task.empty())
        {
            auto c = task.top();
            task.pop();

            if (visited.at(c.first))
            {
                when_visited(c.first, c.second, ans.at(c.first));
                continue;
            }
            visited.at(c.first) = true;
            ans.at(c.first) = c.second;
            not_visited(c.first, c.second);

            for (auto e : g.at(c.first))
                task.push(make_pair(e.to, f(c.first, c.second, e.cost)));
        }

        return ans;
    }

    // ここにdijkstraとかsccとかを
};
